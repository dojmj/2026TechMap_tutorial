@Tutorials(name: "Vision Pro Hand Skeleton으로 Squeeze Interaction 만들기") {
    
    @Intro(title: "손으로 직접 왁뿌볼을 눌러보세요") {
        
        Apple Vision Pro의 Hand Skeleton Joint 데이터를 분석해
        손가락의 접힘 정도를 `graspProgress`로 변환하고,
        RealityKit의 왁뿌볼 인터랙션에 연결합니다.
        
        @Image(
               source: Step02-04,
               alt: "Vision Pro에서 왁뿌볼을 양손으로 누르는 모습"
               )
    }
    
    @Chapter(name: "프로젝트 시작하기") {
        
        visionOS 프로젝트를 생성하고
        RealityKit Scene을 준비합니다.
        
        @Image(
               source: Step01-01,
               alt: "visionOS 프로젝트 설정"
               )
        
        @TutorialReference(
                           tutorial: "doc:01-ProjectSetup"
                           )
    }
    
    @Chapter(name: "Hand Tracking 시작하기") {
        
        ARKitSession과 HandTrackingProvider를 사용해
        사용자의 손을 추적합니다.
        
        @Image(
               source: Step02-01,
               alt: "Vision Pro Hand Tracking"
               )
        
        @TutorialReference(
                           tutorial: "doc:02-HandTracking"
                           )
    }
    
    @Chapter(name: "Hand Skeleton 분석하기") {
        
        HandAnchor에서 각 손가락 Joint의
        위치를 가져옵니다.
        
        @Image(
               source: Step02-04,
               alt: "Hand Skeleton Joint"
               )
        
        @TutorialReference(
                           tutorial: "doc:03-HandJoints"
                           )
    }
    
    @Chapter(name: "손가락 거리 계산하기") {
        
        Fingertip과 손의 기준점 사이의
        3D 거리를 계산합니다.

        @Image(
               source: Step02-03,
               alt: "손가락 거리값을 확인하는 Xcode Console"
               )
        
        @TutorialReference(
                           tutorial: "doc:04-FingerDistance"
                           )
    }
    
    @Chapter(name: "graspProgress 만들기") {
        
        거리값을 0에서 1 사이의
        손가락 접힘 값으로 변환합니다.

        @Image(
               source: Step02-04,
               alt: "손가락을 오므려 graspProgress를 만드는 모습"
               )
        
        @TutorialReference(
                           tutorial: "doc:05-GraspProgress"
                           )
    }
    
    @Chapter(name: "왁뿌볼 눌러보기") {
        
        graspProgress를 RealityKit Entity에 연결해
        공을 실시간으로 변형합니다.

        @Image(
               source: Step01-03,
               alt: "RealityKit에서 표시한 왁뿌볼 모델"
               )
        
        @TutorialReference(
                           tutorial: "doc:06-WaxBallDeformation"
                           )
    }
    
    @Chapter(name: "왁뿌볼 터뜨리기") {
        
        Threshold를 넘었을 때
        공의 파손 효과를 실행합니다.

        @Image(
               source: Step01-03,
               alt: "파괴 단계가 적용되는 왁뿌볼 모델"
               )
        
        @TutorialReference(
                           tutorial: "doc:07-BreakInteraction"
                           )
    }
    
    @Chapter(name: "양손 Squeeze 만들기") {
        
        왼손과 오른손의 값을 결합해
        최종 양손 인터랙션을 완성합니다.

        @Image(
               source: Step02-04,
               alt: "양손으로 왁뿌볼을 누르는 모습"
               )
        
        @TutorialReference(
                           tutorial: "doc:08-TwoHandSqueeze"
                           )
    }
}
