#usda 1.0
(
    defaultPrim = "butterbar1"
)

def "butterbar1" (
    active = true
    customData = {
        float3 rotationEulerHint = (-1.5707964, 0, 0)
    }
    prepend references = @butterbar1.usdz@
)
{
    quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
    float3 xformOp:scale = (5, 5, 5)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    over "_materials"
    {
        over "Material_020"
        {
            token outputs:mtlx:surface
            token outputs:realitykit:vertex
        }

        over "Material_011"
        {
            token outputs:mtlx:surface.connect = </butterbar1/_materials/Material_011/PreviewSurface.outputs:out>
            token outputs:realitykit:vertex
            token outputs:surface.connect = </butterbar1/_materials/Material_011/Principled_BSDF.outputs:surface>
            float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (0, 110.5)

            over "Principled_BSDF" (
                active = false
            )
            {
            }

            def Shader "PreviewSurface"
            {
                uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
                float inputs:clearcoat
                float inputs:clearcoatRoughness
                color3f inputs:diffuseColor = (0.9541369, 1, 0.8395415) (
                    colorSpace = "srgb_displayp3"
                )
                color3f inputs:emissiveColor = (0.90269107, 0.90882814, 0.6936263) (
                    colorSpace = "srgb_displayp3"
                )
                float inputs:ior
                float3 inputs:normal
                float inputs:occlusion = 0.8
                float inputs:opacity = 0.3
                float inputs:opacityThreshold
                float inputs:roughness = 0.8
                token outputs:out
                float2 ui:nodegraph:node:pos = (-201.58203, 122.44922)
                int ui:nodegraph:node:stackingOrder = 21
                string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["Advanced", "inputs:metallic"]
            }
        }
    }
}

